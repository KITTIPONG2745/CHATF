<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>โปรไฟล์ผู้เล่น ROV</title>
    <style>
        /* การตั้งค่าทั่วไป */
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;  /* พื้นหลังสีเทาอ่อน */
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            transition: background-image 0.3s ease-in-out;
        }

        /* กล่องโปรไฟล์ */
        .profile-container {
            background-color: rgba(255, 255, 255, 0.6);  /* ทำให้โปรไฟล์โปร่งใสขึ้น */
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            width: 90%;
            max-width: 600px;
            padding: 40px;
            text-align: center;
            transition: transform 0.3s ease-in-out;
        }

        .profile-container:hover {
            transform: scale(1.02);
        }

        /* ขอบรูปโปรไฟล์ */
        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background-image: url('https://link-to-avatar-image.com/avatar.jpg');
            background-size: cover;
            background-position: center;
            margin: 0 auto 20px;
            border: 4px solid #4CAF50;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }

        /* ชื่อผู้เล่น */
        h1 {
            font-size: 2rem;
            color: #333;  /* เปลี่ยนสีชื่อเป็นสีเข้ม */
            margin-bottom: 10px;
            font-weight: bold;
        }

        /* ข้อมูลโปรไฟล์ */
        .profile-info {
            font-size: 1.3rem;
            margin-bottom: 15px;
            color: #333;  /* สีเทาอ่อน */
        }

        /* สถิติ */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 30px;
        }

        .stat-item {
            background-color: #4CAF50;
            color: #fff;
            padding: 10px;
            border-radius: 8px;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        .stat-item strong {
            display: block;
            font-size: 1.5rem;
        }

        /* ปุ่มเลือกภาพ */
        .file-input {
            margin-top: 20px;
            padding: 10px;
            font-size: 1rem;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .file-input:hover {
            background-color: #45a049;
        }

        /* ป็อปอัพที่ซ่อน */
        .popup {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .popup-content {
            background-color: rgb(102, 41, 41);
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .close-btn {
            background-color: #ff4b5c;
            color: white;
            padding: 5px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
        }

        .close-btn:hover {
            background-color: #ff2a34;
        }
    </style>
</head>
<body>
    <div class="profile-container">
        <div id="avatar" class="avatar"></div>
        <h1>เทพซดแกง</h1>
        <p class="profile-info">ระดับ: เทพเจ้า</p>
        <p class="profile-info">ฮีโร่ที่เล่นบ่อย: Paine</p>
    
        <div class="stats">
            <div class="stat-item">
                <strong>ชนะ</strong>
                999
            </div>
            <div class="stat-item">
                <strong>แพ้</strong>
                1
            </div>
            <div class="stat-item">
                <strong>เกมทั้งหมด</strong>
                1000
            </div>
        </div>
    </div>

    <!-- ป็อปอัพสำหรับเลือกภาพ -->
    <div id="popup" class="popup">
        <div class="popup-content">
            <h2>เลือกพื้นหลัง</h2>
            <input type="file" id="backgroundFile" class="file-input" accept="image/*" onchange="changeBackground(event)">
            <input type="file" id="profileFile" class="file-input" accept="image/*" onchange="changeProfile(event)">
            <button class="close-btn" onclick="closePopup()">ปิด</button>
        </div>
    </div>

    <script>
        // ตัวแปรนับจำนวนการกดปุ่ม 'P'
        let pPressCount = 0;
        let timer;
        let popupVisible = false;  // ใช้ติดตามสถานะการแสดงป็อปอัพ

        // ตรวจจับการกดปุ่ม 'P'
        document.addEventListener('keydown', function(event) {
            if (event.key === 'p' || event.key === 'P') {
                pPressCount++;
                
                // เมื่อกด 'P' ครบ 5 ครั้ง
                if (pPressCount === 5) {
                    // แสดงป็อปอัพ
                    if (!popupVisible) {
                        document.getElementById('popup').style.display = 'flex';
                        popupVisible = true;
                    }
                    clearTimeout(timer); // รีเซ็ตการจับเวลา
                }
                
                // รีเซ็ตการจับเวลา
                clearTimeout(timer);
                timer = setTimeout(() => pPressCount = 0, 5000); // รีเซ็ตหลังจาก 5 วินาที
            }
        });

        // ฟังก์ชันเปลี่ยนพื้นหลัง
        function changeBackground(event) {
            const file = event.target.files[0];
            const reader = new FileReader();

            reader.onload = function(e) {
                document.body.style.backgroundImage = `url(${e.target.result})`;
                // บันทึกพื้นหลังใน localStorage
                localStorage.setItem('background', e.target.result);
            }

            if (file) {
                reader.readAsDataURL(file); // อ่านไฟล์เป็น URL
            }
        }

        // ฟังก์ชันเปลี่ยนโปรไฟล์
        function changeProfile(event) {
            const file = event.target.files[0];
            const reader = new FileReader();

            reader.onload = function(e) {
                document.getElementById('avatar').style.backgroundImage = `url(${e.target.result})`;
                // บันทึกรูปโปรไฟล์ใน localStorage
                localStorage.setItem('profile', e.target.result);
            }

            if (file) {
                reader.readAsDataURL(file); // อ่านไฟล์เป็น URL
            }
        }

        // ฟังก์ชันโหลดรูปจาก localStorage เมื่อโหลดหน้า
        window.onload = function() {
            const savedBackground = localStorage.getItem('background');
            const savedProfile = localStorage.getItem('profile');

            if (savedBackground) {
                document.body.style.backgroundImage = `url(${savedBackground})`;
            }

            if (savedProfile) {
                document.getElementById('avatar').style.backgroundImage = `url(${savedProfile})`;
            }
        }

        // ฟังก์ชันสำหรับปิดป็อปอัพ
        function closePopup() {
            document.getElementById('popup').style.display = 'none';
            popupVisible = false; // รีเซ็ตสถานะการแสดงป็อปอัพ
        }
    </script>
</body>
</html>
